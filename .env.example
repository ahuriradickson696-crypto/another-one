# Server-side only (Vercel → Settings → Environment Variables). Never prefix with VITE_.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional (application form backend)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Contact form + newsletter (server side, set in Vercel). Use ONE of these two options:
# RESEND_API_KEY=
# FORMS_TO_EMAIL=info@aviu.ac.ug
# FORMS_FROM_EMAIL=AVIU Website <no-reply@aviu.ac.ug>
# FORMS_WEBHOOK_URL=

# Visitor statistics (Google Analytics 4). Only runs after a visitor accepts all cookies.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Applications stored in Redis. Vercel adds these for you when you connect an Upstash Redis database
# (Vercel → Storage → Marketplace → Upstash Redis). Either naming works:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (or KV_REST_API_URL / KV_REST_API_TOKEN)
# Long random string that lets Admissions download applications at /api/applications
# ADMIN_TOKEN=
