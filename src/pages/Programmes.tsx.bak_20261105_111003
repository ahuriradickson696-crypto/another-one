// src/pages/Programmes.tsx
// Renders ONLY the 66 programmes from src/data/programmes.ts
import { useState } from "react";
import { Search, BookOpen } from "lucide-react";
import { programmesData } from "@/data/programmes";

const FACULTIES = ["All", "Education & Humanities", "Business & ICT", "Health Sciences", "Social Sciences"];
const LEVELS = ["All", "Graduate Degree", "Undergraduate Degree", "Undergraduate Diploma", "Health Sciences Certificate", "UBTEB Certificate"];

export function Programmes() {
  const [search, setSearch] = useState("");
  const [faculty, setFaculty] = useState("All");
  const [level, setLevel] = useState("All");

  const filtered = programmesData.filter((p) => {
    const matchSearch = p.name.toLowerCase().includes(search.toLowerCase());
    const matchFaculty = faculty === "All" || p.faculty === faculty;
    const matchLevel = level === "All" || p.level === level;
    return matchSearch && matchFaculty && matchLevel;
  });

  return (
    <div className="page-content" style={{ background: "#f9f6fd", paddingBottom: "80px" }}>
      <section style={{ background: "#2d1454", color: "#fff", padding: "80px 20px", textAlign: "center" }}>
        <h1 style={{ fontSize: "clamp(32px, 5vw, 48px)", fontFamily: "'Playfair Display', serif", margin: 0 }}>Our Programmes</h1>
        <p style={{ opacity: 0.8, marginTop: 12, fontSize: 18 }}>66 accredited programmes across five levels.</p>
      </section>

      <section style={{ maxWidth: "1100px", margin: "40px auto 0", padding: "0 20px" }}>
        <div style={{ display: "flex", justifyContent: "center", marginBottom: "24px" }}>
          <div style={{ position: "relative", width: "100%", maxWidth: "420px" }}>
            <Search size={18} style={{ position: "absolute", left: 14, top: "50%", transform: "translateY(-50%)", color: "#8a7fa0" }} />
            <input type="text" placeholder="Search programmes..." value={search}
              onChange={(e) => setSearch(e.target.value)}
              style={{ width: "100%", padding: "12px 16px 12px 42px", borderRadius: "8px", border: "1px solid #e0d4ee", outline: "none" }} />
          </div>
        </div>

        <div style={{ display: "flex", gap: "8px", flexWrap: "wrap", justifyContent: "center", marginBottom: "12px" }}>
          {FACULTIES.map((f) => (
            <button key={f} onClick={() => setFaculty(f)}
              style={{ padding: "8px 16px", borderRadius: "999px", border: "none", cursor: "pointer", fontSize: "13px", fontWeight: 600, background: faculty === f ? "#3d1a6b" : "#fff", color: faculty === f ? "#fff" : "#3d1a6b", boxShadow: "0 2px 8px rgba(0,0,0,0.05)" }}>{f}</button>
          ))}
        </div>

        <div style={{ display: "flex", gap: "8px", flexWrap: "wrap", justifyContent: "center", marginBottom: "30px" }}>
          {LEVELS.map((l) => (
            <button key={l} onClick={() => setLevel(l)}
              style={{ padding: "6px 12px", borderRadius: "8px", border: "1px solid #e0d4ee", cursor: "pointer", fontSize: "12px", fontWeight: 600, background: level === l ? "#f0e8fa" : "#fff", color: "#3d1a6b" }}>{l}</button>
          ))}
        </div>

        <div style={{ textAlign: "center", marginBottom: "30px", color: "#8a7fa0" }}>
          Showing {filtered.length} of {programmesData.length} programmes
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(320px, 1fr))", gap: "20px" }}>
          {filtered.length === 0 ? (
            <div style={{ gridColumn: "1/-1", textAlign: "center", padding: "40px", color: "#8a7fa0" }}>No results found</div>
          ) : (
            filtered.map((p) => (
              <div key={p.id} style={{ background: "#fff", padding: "24px", borderRadius: "16px", boxShadow: "0 4px 15px rgba(0,0,0,0.05)", border: "1px solid #e0d4ee" }}>
                <div style={{ display: "flex", alignItems: "center", gap: 8, color: "#3d1a6b", fontSize: 12, fontWeight: 600, textTransform: "uppercase", marginBottom: 12 }}>
                  <BookOpen size={16} /> {p.level}
                </div>
                <h3 style={{ color: "#2d1454", fontSize: "18px", fontWeight: 700, margin: "0 0 8px" }}>{p.name}</h3>
                <p style={{ color: "#5a4b6b", fontSize: "14px", margin: 0 }}>{p.faculty} · {p.duration}</p>
              </div>
            ))
          )}
        </div>
      </section>
    </div>
  );
}