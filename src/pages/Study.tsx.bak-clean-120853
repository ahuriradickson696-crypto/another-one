import { useMemo, useState } from 'react';
import { ArrowRight, Check, Clock, Search, X, GraduationCap, BookOpen } from 'lucide-react';
import { faculties, type Faculty } from '@/data/university';
import { PageHero } from '@/components/PageHero';
import { useRouter } from '@/router/Router';
import { BackgroundCarousel } from '@/components/BackgroundCarousel';
import { pageImages } from '@/data/pageImages';
import { useApply } from '@/components/ApplyContext';
import { MomentsStrip } from '@/components/MomentsStrip';

const levelFilters = [
  'All',
  'Certificate',
  'Diploma',
  'Bachelor',
  'Postgraduate Diploma',
  'Masters',
  'PhD',
] as const;

export function Study() {
  const { navigate } = useRouter();
  const { openApply } = useApply();
  const [levelFilter, setLevelFilter] = useState<string>('All');
  const [searchQuery, setSearchQuery] = useState('');
  const [activeFaculty, setActiveFaculty] = useState<Faculty | null>(null);

  const allProgrammes = useMemo(
    () =>
      faculties.flatMap((f) =>
        f.programs.map((p) => ({
          ...p,
          facultyName: f.shortName,
          facultyId: f.id,
          facultyIcon: f.icon,
        }))
      ),
    []
  );

  const filteredProgrammes = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    return allProgrammes.filter((p) => {
      const matchesLevel = levelFilter === 'All' || p.level === levelFilter;
      if (!matchesLevel) return false;
      if (!q) return true;
      return (
        p.name.toLowerCase().includes(q) ||
        p.facultyName.toLowerCase().includes(q) ||
        (p.description && p.description.toLowerCase().includes(q)) ||
        (p.discipline && p.discipline.toLowerCase().includes(q))
      );
    });
  }, [allProgrammes, levelFilter, searchQuery]);

  const totalCount = allProgrammes.length;
  const shownCount = filteredProgrammes.length;

  return (
    <div className="page-content">
      <PageHero
        images={pageImages.study}
        eyebrow="Academics"
        title={
          <>
            Programmes at <em>AVIU</em>
          </>
        }
        subtitle="Accredited Bachelor programmes across Education, Business & ICT, Nursing & Health Sciences, and Social Sciences. Research-oriented teaching, practical placements and clear pathways. PhD programmes coming soon. Download programme guides from the Downloads page."
      />

      <MomentsStrip
        keys={['camStage', 'camRibbon', 'class2026']}
        eyebrow="New programme launch"
        title="Complementary and Alternative Medicine"
      />

      {/* Full catalogue with search + filters */}
      <section className="section-pad alt-bg">
        <div className="section-heading">
          <div>
            <div className="eyebrow">
              <span className="eyebrow-line" /> All Programmes
            </div>
            <h2>
              Browse our <em>full programme catalogue.</em>
            </h2>
            <p style={{ marginTop: 8, color: 'var(--ink-soft)', fontSize: 15 }}>
              {shownCount === totalCount
                ? `${totalCount} programmes`
                : `Showing ${shownCount} of ${totalCount} programmes`}
            </p>
          </div>
        </div>

        {/* Search */}
        <div
          style={{
            position: 'relative',
            maxWidth: 480,
            marginBottom: 20,
          }}
        >
          <Search
            size={18}
            style={{
              position: 'absolute',
              left: 14,
              top: '50%',
              transform: 'translateY(-50%)',
              color: 'var(--ink-soft)',
              pointerEvents: 'none',
            }}
          />
          <input
            type="search"
            placeholder="Search by programme, faculty or keyword…"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            aria-label="Search programmes"
            style={{
              width: '100%',
              padding: '12px 16px 12px 42px',
              borderRadius: 10,
              border: '1px solid var(--border, #e2e0eb)',
              background: 'var(--surface, #fff)',
              fontSize: 15,
              outline: 'none',
            }}
          />
          {searchQuery && (
            <button
              type="button"
              aria-label="Clear search"
              onClick={() => setSearchQuery('')}
              style={{
                position: 'absolute',
                right: 10,
                top: '50%',
                transform: 'translateY(-50%)',
                background: 'none',
                border: 'none',
                cursor: 'pointer',
                color: 'var(--ink-soft)',
                padding: 4,
              }}
            >
              <X size={16} />
            </button>
          )}
        </div>

        {/* Level filters */}
        <div className="news-filters" style={{ marginBottom: 28, flexWrap: 'wrap', gap: 8 }}>
          {levelFilters.map((level) => (
            <button
              key={level}
              type="button"
              className={`filter-chip ${levelFilter === level ? 'chip-active' : ''}`}
              onClick={() => setLevelFilter(level)}
            >
              {level}
            </button>
          ))}
        </div>

        {filteredProgrammes.length === 0 ? (
          <div
            style={{
              textAlign: 'center',
              padding: '48px 24px',
              color: 'var(--ink-soft)',
              background: 'var(--surface, #fff)',
              borderRadius: 12,
              border: '1px dashed var(--border, #e2e0eb)',
            }}
          >
            <BookOpen size={36} style={{ marginBottom: 12, opacity: 0.5 }} />
            <p style={{ margin: 0, fontSize: 16 }}>
              No programmes match your filters.
            </p>
            <p style={{ margin: '8px 0 0', fontSize: 14 }}>
              Try a different level or clear the search. PhD programmes are coming soon —
              register interest via Research.
            </p>
            <button
              type="button"
              className="button button-primary"
              style={{ marginTop: 16 }}
              onClick={() => {
                setLevelFilter('All');
                setSearchQuery('');
              }}
            >
              Clear filters
            </button>
          </div>
        ) : (
          <div className="programme-catalogue">
            {filteredProgrammes.map((prog, index) => (
              <article className="programme-row" key={`${prog.name}-${index}`}>
                <div className="programme-row-main">
                  <strong>{prog.name}</strong>
                  <span className="programme-faculty-tag">{prog.facultyName}</span>
                </div>
                <p className="programme-desc">{prog.description}</p>
                <div className="programme-row-meta">
                  <span className="programme-level-tag">{prog.level}</span>
                  <span className="programme-duration">
                    <Clock size={12} /> {prog.duration}
                  </span>
                  {prog.discipline && (
                    <span className="programme-level-tag">{prog.discipline}</span>
                  )}
                  {prog.lastAccreditation && (
                    <span className="programme-duration">
                      NCHE accred. {prog.lastAccreditation}
                      {prog.reviewYear ? ` · review ${prog.reviewYear}` : ''}
                    </span>
                  )}
                  {prog.campus && (
                    <span className="programme-duration">{prog.campus}</span>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      {/* Explore by faculty */}
      <section className="section-pad">
        <div className="section-heading">
          <div>
            <div className="eyebrow">
              <span className="eyebrow-line" /> Programme Details
            </div>
            <h2>
              Explore by <em>faculty.</em>
            </h2>
          </div>
        </div>

        <div className="programme-list">
          {faculties.map((faculty) => (
            <div
              className="programme-faculty"
              key={faculty.id}
              role="button"
              tabIndex={0}
              style={{ cursor: 'pointer' }}
              onClick={() => setActiveFaculty(faculty)}
              onKeyDown={(e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                  e.preventDefault();
                  setActiveFaculty(faculty);
                }
              }}
            >
              <div className="programme-faculty-header">
                <faculty.icon size={20} strokeWidth={1.5} />
                <h3>{faculty.name}</h3>
              </div>
              <p className="faculty-long-desc">{faculty.longDescription}</p>
              <ul>
                {faculty.programs.map((program) => (
                  <li key={program.name}>
                    <span className="programme-bullet">
                      <Check size={13} />
                    </span>
                    <div className="programme-list-item">
                      <span className="programme-list-name">{program.name}</span>
                      <span className="programme-list-meta">
                        {program.level} · {program.duration}
                        {program.lastAccreditation
                          ? ` · NCHE ${program.lastAccreditation}${
                              program.reviewYear ? ` (review ${program.reviewYear})` : ''
                            }`
                          : ''}
                      </span>
                      {program.description && (
                        <p
                          style={{
                            margin: '4px 0 0',
                            fontSize: 14,
                            color: 'var(--ink-soft)',
                            lineHeight: 1.65,
                          }}
                        >
                          {program.description}
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
              <div style={{ marginTop: 12 }}>
                <span className="text-link" style={{ fontSize: 14 }}>
                  View faculty details <ArrowRight size={14} />
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Graduate studies */}
      <section className="section-pad" id="graduate-studies">
        <div className="section-heading">
          <div>
            <div className="eyebrow">
              <span className="eyebrow-line" /> Graduate study
            </div>
            <h2>
              Postgraduate pathways &amp; <em>research.</em>
            </h2>
          </div>
        </div>
        <p
          style={{
            maxWidth: 760,
            marginBottom: 20,
            fontSize: 16,
            lineHeight: 1.75,
            color: 'var(--ink-soft)',
          }}
        >
          AVIU is expanding graduate education under NCHE programme development processes.
          Postgraduate diplomas and further awards are developed faculty by faculty.{' '}
          <strong>PhD by research programmes are coming soon</strong> — register interest via the
          Research Office. Graduate study aligns with the university&apos;s CEBAT-informed focus on
          competence, enterprise, and applied learning.
        </p>
        <div className="grid-3" style={{ gap: 16, marginBottom: 20 }}>
          {[
            {
              t: 'Postgraduate pathways',
              d: 'Diploma-to-degree upgrades and emerging PG awards. Confirm current offers with Admissions.',
              path: '/programs/postgraduate',
            },
            {
              t: 'Research & conferences',
              d: 'Annual Research Conference, Innovation Fair, centres and publication routes.',
              path: '/research',
            },
            {
              t: 'PhD opportunities',
              d: 'Doctoral recruitment status and how to register interest.',
              path: '/research/phd-opportunities',
            },
          ].map((x) => (
            <button
              key={x.t}
              type="button"
              className="info-card"
              style={{ padding: 20, textAlign: 'left', cursor: 'pointer' }}
              onClick={() => navigate(x.path)}
            >
              <strong style={{ display: 'block', marginBottom: 6 }}>{x.t}</strong>
              <span style={{ fontSize: 14, color: 'var(--ink-soft)', lineHeight: 1.5 }}>
                {x.d}
              </span>
            </button>
          ))}
        </div>
      </section>

      {/* CTA */}
      <section className="cta-section">
        <BackgroundCarousel images={pageImages.study} overlay={0.88} />
        <div>
          <div className="eyebrow eyebrow-light">
            <span className="eyebrow-line" /> Ready to apply?
          </div>
          <h2>Start your journey.</h2>
          <p>Applications are now open for all intakes — January, May, and August.</p>
        </div>
        <button type="button" className="button button-light" onClick={() => openApply()}>
          Apply now <ArrowRight size={17} />
        </button>
      </section>

      {/* Faculty detail modal */}
      {activeFaculty && (
        <div
          className="modal-backdrop"
          onClick={() => setActiveFaculty(null)}
          role="presentation"
        >
          <div
            className="inquiry-modal"
            onClick={(e) => e.stopPropagation()}
            role="dialog"
            aria-modal="true"
            aria-labelledby="faculty-modal-title"
          >
            <button
              type="button"
              className="modal-close"
              aria-label="Close"
              onClick={() => setActiveFaculty(null)}
            >
              <X size={20} />
            </button>
            <activeFaculty.icon size={32} strokeWidth={1.5} />
            <h3 id="faculty-modal-title">{activeFaculty.name}</h3>
            <p className="modal-desc">{activeFaculty.longDescription}</p>
            <div className="modal-programmes">
              <strong>Programmes offered:</strong>
              <ul>
                {activeFaculty.programs.map((p) => (
                  <li key={p.name}>
                    <Check size={14} /> {p.name}{' '}
                    <span className="modal-prog-meta">
                      — {p.level}, {p.duration}
                      {p.lastAccreditation ? ` · NCHE ${p.lastAccreditation}` : ''}
                    </span>
                    <span
                      style={{
                        display: 'block',
                        fontSize: 13,
                        color: 'var(--ink-soft)',
                        marginLeft: 22,
                        marginTop: 2,
                      }}
                    >
                      {p.description}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <button
              type="button"
              className="button button-primary"
              onClick={() => {
                setActiveFaculty(null);
                openApply();
              }}
            >
              Apply to this faculty <ArrowRight size={16} />
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
